# Copy this file to `.env` locally and replace the placeholders.
# Never commit real credentials.

# PostgreSQL connection string used by Prisma Client and Prisma CLI.
# Example shape only — do not use these values in production.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/osiria?schema=public"

# Optional direct (non-pooled) URL for Prisma Migrate when DATABASE_URL
# points at a pooler such as PgBouncer. Leave unset for a local database.
# DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/osiria?schema=public"

# Public origin used in password-reset links. Required in production.
# APP_ORIGIN="http://localhost:3000"

# Optional webhook that receives password-reset email payloads.
# If unset, development logs the link on the server only. Production does not.
# AUTH_EMAIL_WEBHOOK=""

# Operator-supplied admin bootstrap for `npm run auth:create-admin`.
# There is no default password. Do not commit real values.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
